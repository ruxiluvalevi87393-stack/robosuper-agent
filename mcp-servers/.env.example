# MCP 服务端配置 —— 仅 MCP 专属配置，**不含任何密钥**。
# PG/Neo4j 凭据复用 backend/.env（common/config.py 按序加载两个文件）。
# 安全约定：这里只允许列配置键，绝不提交密钥值。

# streamable HTTP 监听地址
MCP_HOST=127.0.0.1

# 各服务端口（9101–9106，避开 Docker 占用的 9001）
ALARM_GRAPH_MCP_PORT=9101
SERVO_PARAM_MCP_PORT=9102
EPC_PARTS_MCP_PORT=9103
LINE_STATUS_MCP_PORT=9104
INVENTORY_MCP_PORT=9105
WORK_ORDER_MCP_PORT=9106
